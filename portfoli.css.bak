/* ==================== GLOBAL STYLES ==================== */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --bg: #07090f;
    --panel: #0c1019;
    --panel-2: #101624;
    --text: #f4f7ff;
    --text-muted: #aab2c5;
    --cyan: #37d5ff;
    --line: rgba(255, 255, 255, 0.08);
    --glow: 0 0 0 1px rgba(55, 213, 255, 0.25), 0 0 22px rgba(55, 213, 255, 0.2);
    --radius: 18px;
    --trans: all 0.28s ease;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    line-height: 1.7;
    color: var(--text);
    background:
        radial-gradient(circle at top, #0f172a, #020617),
        linear-gradient(135deg, #0f172a, #1e293b);
    min-height: 100vh;
}

body::before {
    content: '';
    position: fixed;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(circle at 15% 20%, rgba(56, 189, 248, 0.16), transparent 35%),
                radial-gradient(circle at 85% 8%, rgba(99, 102, 241, 0.14), transparent 32%);
    z-index: -1;
}

.bg-3d-scene {
    position: fixed;
    inset: -14% -10% 0 -10%;
    pointer-events: none;
    z-index: -2;
    perspective: 1200px;
    transform-style: preserve-3d;
    overflow: hidden;
}

.bg-orb {
    position: absolute;
    display: block;
    border-radius: 50%;
    filter: blur(0.4px);
    transform-style: preserve-3d;
    opacity: 0.55;
    will-change: transform;
}

.orb-1 {
    width: clamp(180px, 20vw, 320px);
    height: clamp(180px, 20vw, 320px);
    left: 7%;
    top: 12%;
    background: radial-gradient(circle at 30% 30%, rgba(56, 189, 248, 0.9), rgba(56, 189, 248, 0.12) 62%, transparent 72%);
    box-shadow: 0 0 120px rgba(56, 189, 248, 0.25);
    animation: orbFloatA 18s ease-in-out infinite;
}

.orb-2 {
    width: clamp(220px, 24vw, 360px);
    height: clamp(220px, 24vw, 360px);
    right: 8%;
    top: 16%;
    background: radial-gradient(circle at 35% 35%, rgba(129, 140, 248, 0.9), rgba(129, 140, 248, 0.1) 66%, transparent 76%);
    box-shadow: 0 0 140px rgba(129, 140, 248, 0.24);
    animation: orbFloatB 21s ease-in-out infinite;
}

.orb-3 {
    width: clamp(170px, 18vw, 280px);
    height: clamp(170px, 18vw, 280px);
    left: 42%;
    bottom: 8%;
    background: radial-gradient(circle at 35% 35%, rgba(45, 212, 191, 0.82), rgba(45, 212, 191, 0.08) 64%, transparent 74%);
    box-shadow: 0 0 120px rgba(45, 212, 191, 0.2);
    animation: orbFloatC 24s ease-in-out infinite;
}

@keyframes orbFloatA {
    0%,
    100% { transform: translate3d(0, 0, -120px) rotateX(12deg) rotateY(-10deg) scale(1); }
    50% { transform: translate3d(34px, -24px, 90px) rotateX(-10deg) rotateY(12deg) scale(1.08); }
}

@keyframes orbFloatB {
    0%,
    100% { transform: translate3d(0, 0, 80px) rotateX(-12deg) rotateY(8deg) scale(1.02); }
    50% { transform: translate3d(-36px, 28px, -90px) rotateX(11deg) rotateY(-10deg) scale(0.94); }
}

@keyframes orbFloatC {
    0%,
    100% { transform: translate3d(0, 0, -80px) rotateX(8deg) rotateY(14deg) scale(1); }
    50% { transform: translate3d(16px, -34px, 110px) rotateX(-9deg) rotateY(-12deg) scale(1.1); }
}

body,
.nav-pill,
.theme-toggle,
.education-item,
.experience-item,
.skill-category,
.project-card,
.achievement,
.contact-item,
.project-link,
.cta-button,
.social-links a,
.filter-chip {
    transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
}

body.light-mode {
    --bg: #f5f9ff;
    --panel: #ffffff;
    --panel-2: #eef5ff;
    --text: #0f172a;
    --text-muted: #42526b;
    --line: rgba(15, 23, 42, 0.15);
    --glow: 0 0 0 1px rgba(8, 145, 178, 0.2), 0 6px 20px rgba(8, 145, 178, 0.18);
    background:
        radial-gradient(circle at 8% 14%, rgba(56, 189, 248, 0.18), transparent 24%),
        radial-gradient(circle at 88% 24%, rgba(14, 165, 233, 0.18), transparent 28%),
        linear-gradient(180deg, #f8fbff, #eef6ff 42%, #f4f9ff 100%);
}

body.light-mode .bg-orb {
    opacity: 0.45;
}

body.light-mode .nav-pill,
body.light-mode .theme-toggle {
    background: rgba(255, 255, 255, 0.92);
    border-color: rgba(15, 23, 42, 0.14);
}

body.light-mode .theme-toggle {
    color: #f59e0b;
}

body.light-mode .nav-links a {
    color: #334155;
}

body.light-mode .nav-links a:hover {
    color: #0f172a;
    background: rgba(15, 23, 42, 0.08);
}

body.light-mode .hero::before {
    border-color: rgba(8, 145, 178, 0.24);
}

body.light-mode .tagline,
body.light-mode .stat-card h4,
body.light-mode .education-header h3,
body.light-mode .experience-header h3,
body.light-mode .skill-category h4,
body.light-mode .project-header h3,
body.light-mode .achievement h4,
body.light-mode .contact-item h4,
body.light-mode .footer-links a {
    color: #0f172a;
}

body.light-mode .subtitle,
body.light-mode .about p,
body.light-mode .project-description,
body.light-mode .project-features,
body.light-mode .description,
body.light-mode .contact-subtitle,
body.light-mode .detail,
body.light-mode footer,
body.light-mode .footer-content p {
    color: #42526b;
}

body.light-mode section {
    border-top-color: rgba(15, 23, 42, 0.09);
}

body.light-mode .profile-photo {
    border-color: rgba(8, 145, 178, 0.24);
    box-shadow: 0 0 30px rgba(8, 145, 178, 0.15);
}

body.light-mode .education-item,
body.light-mode .experience-item,
body.light-mode .skill-category,
body.light-mode .project-card,
body.light-mode .achievement,
body.light-mode .contact-item {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(241, 247, 255, 0.98));
    border-color: rgba(8, 145, 178, 0.25);
}

body.light-mode .year {
    background: rgba(8, 145, 178, 0.14);
    border-color: rgba(8, 145, 178, 0.32);
    color: #0f172a;
}

body.light-mode .education-timeline::before {
    background: #0891b2;
    opacity: 0.6;
}

body.light-mode .timeline-item::after {
    background: #0891b2;
    border-color: #f8fbff;
    box-shadow: 0 0 0 8px rgba(8, 145, 178, 0.15);
}

body.light-mode .institution,
body.light-mode .company,
body.light-mode .section-kicker,
body.light-mode .hero-kicker,
body.light-mode .achievement i,
body.light-mode .contact-item i,
body.light-mode .social-links a {
    color: #0891b2;
}

body.light-mode .experience-highlights span,
body.light-mode .skill-tag,
body.light-mode .project-tech span,
body.light-mode .project-tag,
body.light-mode .project-link,
body.light-mode .social-links a,
body.light-mode .cta-button.secondary,
body.light-mode .hero-badges span,
body.light-mode .filter-chip {
    border-color: rgba(8, 145, 178, 0.35);
    background: rgba(8, 145, 178, 0.08);
    color: #0f172a;
}

body.light-mode .project-image {
    background: radial-gradient(circle at 20% 20%, rgba(14, 165, 233, 0.22), transparent 36%),
                linear-gradient(135deg, #e8f2ff, #f7fbff);
    border-bottom-color: rgba(8, 145, 178, 0.24);
}

body.light-mode .project-image-placeholder {
    color: #0f172a;
}

body.light-mode .cta-button.primary {
    background: rgba(8, 145, 178, 0.14);
    color: #0f172a;
    border-color: rgba(8, 145, 178, 0.45);
}

body.light-mode .cta-button.primary:hover,
body.light-mode .cta-button.secondary:hover {
    background: rgba(8, 145, 178, 0.2);
}

body.light-mode footer {
    background: rgba(246, 250, 255, 0.95);
    border-top-color: rgba(15, 23, 42, 0.1);
}

body.light-mode #typed-role {
    border-right-color: #0891b2;
}

body.light-mode .bar {
    background: rgba(15, 23, 42, 0.08);
    border-color: rgba(8, 145, 178, 0.24);
}

.container {
    max-width: 1150px;
    margin: 0 auto;
    padding: 0 24px;
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(12px);
    border-radius: 15px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 10px 30px rgba(2, 6, 23, 0.28);
}

